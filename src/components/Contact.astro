---
const EMAIL = "louis.iaeger@gmail.com";

const socials = [
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/louislinkedin",
    icon: "M4.5 4.5h1.2v1.2H4.5V4.5Zm.05 3.2h1.1V15h-1.1V7.7ZM8 7.7h1.05v1.02h.02c.15-.27.5-.55 1.03-.55 1.1 0 1.3.68 1.3 1.57V15H10.3v-3.9c0-.93-.02-2.13-1.32-2.13-1.32 0-1.52 1-1.52 2.06V15H8V7.7Z",
  },
  {
    label: "GitHub",
    href: "https://github.com/louisiaegerv",
    icon: "M10 2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.35c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.17-.89-1.17-.72-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.71 1.22 1.87.87 2.32.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.97 0-.88.31-1.6.83-2.16-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.83a7.6 7.6 0 0 1 4 0c1.53-1.05 2.2-.83 2.2-.83.44 1.11.16 1.93.08 2.13.52.56.83 1.28.83 2.16 0 3.09-1.88 3.77-3.67 3.96.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 10 2Z",
  },
  {
    label: "Email",
    href: `mailto:${EMAIL}`,
    icon: "M3.5 5h13a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 0 6.5 5.5L16.5 5",
  },
];
---

<section id="contact" class="bg-light py-16 lg:py-20">
  <div
    data-reveal
    class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 lg:flex-row lg:items-center lg:px-10"
  >
    <div>
      <h2 class="text-3xl font-extrabold text-ink sm:text-4xl">
        Ready to fix what's holding your business back?
      </h2>
      <p class="mt-3 text-base text-muted">
        Let's find your bottleneck and build a plan that turns it into growth.
      </p>
    </div>

    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <a
        href={`mailto:${EMAIL}`}
        class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-dark transition-transform hover:scale-105"
      >
        <div class="w-[80px]">Let's Talk</div>
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3.5 8h9m0 0L8.5 4m4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <div class="flex items-center gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target={social.href.startsWith("http") ? "_blank" : undefined}
              rel={social.href.startsWith("http") ? "noreferrer" : undefined}
              aria-label={social.label}
              class="flex h-11 w-11 items-center justify-center rounded-lg border border-ink/15 text-ink transition-colors hover:border-accent-dark hover:text-accent-dark"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d={social.icon}
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <p class="mx-auto mt-10 max-w-7xl px-6 text-xs text-muted lg:px-10">
    © {new Date().getFullYear()} Louis Iaeger. All rights reserved.
  </p>
</section>

<script>
  import { revealOnScroll } from "../scripts/reveal";
  revealOnScroll("#contact [data-reveal]");
</script>
